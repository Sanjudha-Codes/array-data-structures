class Solution:    
    def findUnion(self, a, b):
        s=set()
        for num in a:
            s.add(num)
        for num in b:
            s.add(num)
            
        return s    

alternate:

class Solution:    
    def findUnion(self, a, b):
        res=[]
        for item in a:
            if item not in res:
                res.append(item)
                
        for item in b:
            if item not in res:
                res.append(item)
        
        return res        
